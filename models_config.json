{
  "backend": {
    "type": "vllm",
    "vllm_config": {
      "tensor_parallel_size": 2,
      "gpu_memory_utilization": 0.95,
      "max_num_seqs": 16,
      "kv_cache_dtype": "fp8",
      "enable_prefix_caching": true,
      "enable_chunked_prefill": true,
      "trust_remote_code": true,
      "disable_custom_all_reduce": false,
      "enforce_eager": false,
      "use_v2_block_manager": true,
      "block_size": 32,
      "swap_space": 4
    }
  },
  "models": {
    "qwen3-30b-instruct": {
      "name": "unsloth/Qwen3-30B-A3B-Instruct-2507",
      "type": "instruction",
      "size": "30B",
      "description": "Large instruction-following model for complex tasks",
      "quantization": "AWQ",
      "default_params": {
        "temperature": 0.7,
        "max_tokens": 8192,
        "top_p": 0.9
      }
    },
    "phi-4-reasoning": {
      "name": "microsoft/Phi-4",
      "type": "instruction",
      "size": "15B",
      "description": "Medium reasoning model, good balance",
      "quantization": "AWQ",
      "default_params": {
        "temperature": 0.7,
        "max_tokens": 8192,
        "top_p": 0.9
      }
    },
    "qwen3-8b-instruct": {
      "name": "Qwen/Qwen2.5-7B-Instruct",
      "type": "instruction",
      "size": "7B",
      "description": "Fast model for general tasks",
      "quantization": "GPTQ",
      "default_params": {
        "temperature": 0.7,
        "max_tokens": 8192,
        "top_p": 0.9
      }
    },
    "phi-4-mini": {
      "name": "microsoft/Phi-3.5-mini-instruct",
      "type": "instruction",
      "size": "4B",
      "description": "Very fast model for simple tasks",
      "quantization": null,
      "default_params": {
        "temperature": 0.7,
        "max_tokens": 8192,
        "top_p": 0.9
      }
    },
    "qwen3-coder-30b": {
      "name": "stelterlab/Qwen3-Coder-30B-A3B-Instruct-AWQ",
      "type": "coder",
      "size": "30B",
      "description": "Specialized for code generation and programming",
      "quantization": "AWQ",
      "default_params": {
        "temperature": 0.3,
        "max_tokens": 8192,
        "top_p": 0.95
      }
    },
    "qwen3-coder-14b": {
      "name": "Qwen/Qwen2.5-Coder-14B-Instruct",
      "type": "coder", 
      "size": "14B",
      "description": "Smaller coding model - should allow much larger context window",
      "quantization": null,
      "default_params": {
        "temperature": 0.3,
        "max_tokens": 8192,
        "top_p": 0.95
      }
    },
    "qwen3-coder-7b": {
      "name": "Qwen/Qwen2.5-Coder-7B-Instruct", 
      "type": "coder",
      "size": "7B", 
      "description": "Fast coding model with large context support",
      "quantization": null,
      "default_params": {
        "temperature": 0.3,
        "max_tokens": 8192,
        "top_p": 0.95
      }
    }
  },
  "active_model": "qwen3-coder-30b",
  "download_path": "./models",
  "cache_dir": "./cache",
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "log_level": "INFO",
    "use_jinja_template": true,
    "template_dir": "templates"
  }
}